# Required - any OpenAI Chat Completion compatible endpoint.
# Examples:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   http://localhost:11434/v1           (Ollama)
#   https://your-resource.openai.azure.com/openai/deployments/your-deployment
OPENAI_BASE_URL=

# Required - model id passed to the chat completions API.
# Examples:
#   gpt-4o, gpt-4o-mini
#   deepseek-chat
#   qwen2.5-coder:7b
SMALLAGENT_MODEL=

# Optional - API key for the endpoint.
# Required for hosted services (OpenAI, DeepSeek, Azure).
# Leave empty / unset for local endpoints that don't require auth.
OPENAI_API_KEY=