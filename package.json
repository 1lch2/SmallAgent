{
  "name": "liberi-code",
  "version": "0.1.5",
  "description": "Minimalist terminal agent powered by OpenAI-compatible APIs",
  "type": "module",
  "bin": {
    "liberi-code": "dist/liberi-code.js"
  },
  "files": [
    "dist/**",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.1.1",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
